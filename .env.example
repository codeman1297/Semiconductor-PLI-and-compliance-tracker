# Copy to .env and adjust. Never commit .env.

# SQLAlchemy URL. Default is a local SQLite file at ./data/tracker.db
DATABASE_URL=sqlite:///./data/tracker.db

# Public base URL, used to build magic links (Phase 5)
BASE_URL=http://127.0.0.1:8000

# Signs the session cookie. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production

# The single admin account that may reach /admin/* (Phase 4+)
ADMIN_EMAIL=admin@example.com

# Optional LLM answer synthesis over retrieved chunks (Phase 4). Off by default.
LLM_ANSWERS_ENABLED=false
ANTHROPIC_API_KEY=

# Set to true in production behind HTTPS so the session cookie is Secure
COOKIE_SECURE=false
